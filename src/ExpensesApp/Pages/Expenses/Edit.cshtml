@page "/Expenses/Edit/{id:int}"
@model ExpensesApp.Pages.Expenses.EditModel
@{
    ViewData["Title"] = $"Edit Expense #{Model.ExpenseId}";
}

<div class="page-header">
    <div>
        <h1>Edit Expense #@Model.ExpenseId</h1>
        <p class="page-subtitle">Update expense details (Draft only)</p>
    </div>
    <a href="/Expenses/Details/@Model.ExpenseId" class="btn btn-outline">← Back</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card form-card">
    <form method="post">
        <input type="hidden" name="id" value="@Model.ExpenseId" />
        <div class="form-grid">
            <div class="form-group">
                <label for="CategoryId">Category</label>
                <select id="CategoryId" name="CategoryId" class="form-control" required>
                    @foreach (var c in Model.Categories)
                    {
                        if (c.CategoryId == Model.CurrentCategoryId)
                        {
                            <option value="@c.CategoryId" selected>@c.CategoryName</option>
                        }
                        else
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="AmountGBP">Amount (£)</label>
                <div class="input-prefix-wrapper">
                    <span class="input-prefix">£</span>
                    <input type="number" id="AmountGBP" name="AmountGBP" step="0.01" min="0.01"
                           class="form-control" value="@Model.CurrentAmountGBP.ToString("F2")" required />
                </div>
            </div>

            <div class="form-group">
                <label for="ExpenseDate">Expense Date</label>
                <input type="date" id="ExpenseDate" name="ExpenseDate"
                       class="form-control" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group form-group-full">
                <label for="Description">Description</label>
                <textarea id="Description" name="Description" class="form-control" rows="3">@Model.CurrentDescription</textarea>
            </div>

            <div class="form-group form-group-full">
                <label for="ReceiptFile">Receipt Reference</label>
                <input type="text" id="ReceiptFile" name="ReceiptFile"
                       class="form-control" value="@Model.CurrentReceiptFile" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
