@page
@model ExpenseApp.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">
    <div>
        <h1>➕ Add User</h1>
        <p>Create a new team member.</p>
    </div>
    <a href="/Users/Index" class="btn btn-outline">← Back to Users</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">✅ @Model.SuccessMessage</div>
}

<div class="card" style="max-width:600px;">
    <form method="post">
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.UserName">Full Name</label>
                <input type="text" asp-for="Input.UserName" placeholder="Alice Example" required />
            </div>
            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input type="email" asp-for="Input.Email" placeholder="alice@example.com" required />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.RoleId">Role</label>
                <select asp-for="Input.RoleId" required>
                    <option value="1">Employee</option>
                    <option value="2">Manager</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Input.ManagerId">Manager (optional)</label>
                <select asp-for="Input.ManagerId">
                    <option value="">No manager</option>
                    @foreach (var u in Model.Managers)
                    {
                        <option value="@u.UserId">@u.UserName</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 Save User</button>
            <a href="/Users/Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>
